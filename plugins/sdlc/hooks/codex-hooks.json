{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sdlc/bin/plugin-hook.mjs\" SessionStart",
            "statusMessage": "Loading SDLC lifecycle context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sdlc/bin/plugin-hook.mjs\" PreToolUse",
            "statusMessage": "Checking SDLC edit boundary"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sdlc/bin/plugin-hook.mjs\" PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sdlc/bin/plugin-hook.mjs\" Stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sdlc/bin/plugin-hook.mjs\" UserPromptSubmit",
            "statusMessage": "Loading SDLC prompt guidance"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sdlc/bin/plugin-hook.mjs\" PreCompact",
            "statusMessage": "Saving SDLC compact summary"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sdlc/bin/plugin-hook.mjs\" PostCompact",
            "statusMessage": "Restoring SDLC compact summary"
          }
        ]
      }
    ]
  }
}
